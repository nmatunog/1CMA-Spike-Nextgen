# Auth (NextAuth) — production & shared teams: set a strong value:
#   openssl rand -base64 32
# Local `npm run dev` works without this (dev-only fallback in auth.ts).
AUTH_SECRET=

# Demo login (optional — leave unset to disable matching in authorize())
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# Supabase PostgreSQL — required for API routes using Drizzle (leads, candidates).
# Supabase Dashboard → Settings → Database → URI (use pooler, port 6543, for serverless).
# Append ?sslmode=require if your client or host requires explicit SSL.
DATABASE_URL=

# Outbound: n8n workflow webhook URL (lead.created, social events)
N8N_WEBHOOK_URL=

# Optional separate URL for social automation workflows
N8N_SOCIAL_WEBHOOK_URL=

# Inbound from n8n → app/api/webhooks/n8n (optional shared secret)
N8N_INBOUND_SECRET=

# Optional: local Ollama (if OLLAMA_MODEL is set, /api/chat uses it; else stub)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Optional: analytics (Plausible — add script in app/layout if set)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional — only if you add Supabase Auth, Realtime, or Storage later (not used by Drizzle DB routes):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin console (POST /api/admin/verify) — never commit the real password
ADMIN_CONSOLE_PASSWORD=
# GIA: synthetic controlled pilot only; defaults to disabled.
GIA_PILOT_ENABLED=false
GIA_PUBLIC_ORIGIN=http://localhost:3002
# Set a random secret of at least 32 characters; do not reuse staff passwords.
GIA_SESSION_SECRET=
# Staff email -> {salt: 32 hex chars, hash: 128 hex chars from scrypt(password,salt,64)}
RECRUITMENT_STAFF_ACCOUNTS={}
# Staff email -> admin or leader. Credentials and roles are separate controls.
RECRUITMENT_STAFF_ROLES={}
# AIA attributed recruiter registration (Command Center). Do not commit real
# reference values or AIA agent codes. URL must be https://www.aia.com.ph/en/financialadvisor/join-us-now?reference=<base64>.
# AIA_DEFAULT_RECRUITER_STAFF_ID=
# AIA_DEFAULT_RECRUITER_REGISTRATION_URL=
# Optional JSON map of staff id -> attributed registration URL
# AIA_RECRUITER_REGISTRATION_URLS={}
# Mock/dev OTP only. Never enable against real contacts. Never send via paid SMS/email.
GIA_OTP_DEV=false
# Optional distinct OTP HMAC secret; defaults to GIA_SESSION_SECRET (still >= 32 chars).
# GIA_OTP_SECRET=
